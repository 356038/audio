# Copy to /etc/wave.env outside the repository; restrict permissions to root.
# Replace the placeholder securely on the VPS, never commit the real token.
BOT_TOKEN=replace_on_server
FRONTEND_ORIGIN=https://wave.example.com
HOST=127.0.0.1
PORT=8787
# Public Internet Archive catalogue; enabled by default by backend.mjs.
# No additional key is required. Set to 0 to disable this provider.
WAVE_ARCHIVE_ENABLED=1
